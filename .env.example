# OpenAI API Key for the chat assistant
# Get your key from https://platform.openai.com/api-keys
# The chat widget falls back to the Smart Studio Concierge if this is not set
OPENAI_API_KEY=sk-...

# Optional: Addis AI for Amharic / Ge'ez messages
# ADDIS_AI_API_KEY=...
# ADDIS_API_KEY=...

# Optional: Webhook URL(s) to receive captured leads
# LEAD_WEBHOOK_URL=https://...
# CHAT_LEAD_WEBHOOK_URL=https://...

# Optional: Notion leads database
# NOTION_API_KEY=secret_...
# NOTION_LEADS_DB_ID=...

# Optional: Google PageSpeed Insights API key for the website check tool
# PAGESPEED_API_KEY=...
