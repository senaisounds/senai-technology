# OpenAI API Key for the chat assistant
# Get your key from https://platform.openai.com/api-keys
# The chat widget falls back gracefully if this is not set
OPENAI_API_KEY=sk-...

# Optional: Webhook URL to receive captured leads
# Leads are POSTed as JSON: { source, timestamp, name, email, need }
# CHAT_LEAD_WEBHOOK_URL=https://...
